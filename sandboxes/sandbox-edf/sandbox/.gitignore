__pycache__/
*.py[cod]
.DS_Store

# Results are local experiments, except the shipped reference records,
# which travel with every copy of the sandbox.
results/**/*.json
!results/**/gdpa.json
!results/**/hospa.json
results/**/leaderboard.csv
results/**/*.png

# Scratch space: keep the directory, ignore its contents.
tmp/*
!tmp/.gitkeep

# Optional local virtualenv.
.venv/
venv/
